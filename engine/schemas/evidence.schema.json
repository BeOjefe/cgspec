{
  "title": "docs/_cgspec/06-evidence/<scope>/<check-id>.json \u2014 one check or review result",
  "type": "object",
  "required": [
    "schema",
    "check",
    "revision",
    "verdict",
    "ran_at",
    "ran_by"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "check": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "PARTIAL",
        "BLOCKED",
        "NOT_APPLICABLE"
      ]
    },
    "claim": {
      "enum": ["integration", "ui_behavior", "visual", "code_quality", "governance", "other"]
    },
    "data_source": {
      "enum": ["real_backend", "fixture", "static", "unknown"]
    },
    "state": {
      "enum": [
        "Fresh",
        "Stale"
      ]
    },
    "details": {
      "type": "string"
    },
    "not_run": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewer_model": {
      "type": "string"
    },
    "same_model_review": {
      "type": "boolean"
    },
    "ran_at": {
      "type": "string"
    },
    "ran_by": {
      "type": "string"
    },
    "covers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
