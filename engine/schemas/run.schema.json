{
  "title": "docs/_cgspec/05-runs/<run-id>/run.json — one team task with frozen criteria",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "tier",
    "goal",
    "criteria",
    "tests",
    "units",
    "frozen_at",
    "approval"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^R-\\d{8}-[0-9a-f]{4}$"
    },
    "status": {
      "enum": [
        "active",
        "completed",
        "superseded"
      ]
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "superseded_by": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^R-\\d{8}-[0-9a-f]{4}$"
        }
      ]
    },
    "superseded_at": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "tier": {
      "enum": [
        "T1",
        "T2",
        "T3"
      ]
    },
    "slice": {
      "type": "string"
    },
    "goal": {
      "type": "string",
      "minLength": 3
    },
    "criteria": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/hashed"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/hashed"
      }
    },
    "proofs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/hashed"
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersession": {
      "type": "object",
      "required": ["replaces", "reason", "approval", "links", "frozen_at"],
      "additionalProperties": false,
      "properties": {
        "replaces": {"type": "string", "pattern": "^R-\\d{8}-[0-9a-f]{4}$"},
        "reason": {"type": "string", "minLength": 3},
        "approval": {"$ref": "#/definitions/approval"},
        "frozen_at": {"type": "string", "minLength": 1},
        "links": {
          "type": "object",
          "required": ["agreements", "outcomes", "tests", "proofs"],
          "additionalProperties": false,
          "properties": {
            "agreements": {"$ref": "#/definitions/links"},
            "outcomes": {"$ref": "#/definitions/links"},
            "tests": {"$ref": "#/definitions/links"},
            "proofs": {"$ref": "#/definitions/links"}
          }
        }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "owner",
          "allowed_paths",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "allowed_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$)).+$"
            }
          },
          "status": {
            "enum": [
              "todo",
              "in-progress",
              "PASS",
              "FAIL",
              "PARTIAL",
              "BLOCKED",
              "NOT_APPLICABLE"
            ]
          },
          "review_rounds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        }
      }
    },
    "frozen_at": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "approval": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/approval"
        }
      ]
    }
  },
  "definitions": {
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["old", "new"],
        "additionalProperties": false,
        "properties": {
          "old": {"type": "string", "minLength": 1},
          "new": {"type": "string", "minLength": 1}
        }
      }
    },
    "hashed": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "source",
        "ref",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "message-hook",
            "commit-trailer"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string"
        }
      }
    }
  }
}
