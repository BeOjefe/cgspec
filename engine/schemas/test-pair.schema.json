{
  "title": "docs/_cgspec/06-evidence/tests/<test-id>.json \u2014 proof a test failed before the code change",
  "type": "object",
  "required": [
    "schema",
    "test_id",
    "test_file",
    "command",
    "failed_at",
    "covers",
    "slice",
    "recorded"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "test_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]+$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "runner_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "runner_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selector": {"type": "string", "minLength": 1},
    "failed_at": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "passed_at": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        }
      ]
    },
    "covers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$)).+$"
      }
    },
    "slice": {
      "type": "string",
      "pattern": "^([a-z0-9-]+:)?SLICE-\\d{3}$"
    },
    "tier": {
      "enum": [
        "T1",
        "T2",
        "T3"
      ]
    },
    "recorded": {
      "type": "string"
    },
    "test_file": {
      "type": "string",
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$)).+$"
    }
  }
}
