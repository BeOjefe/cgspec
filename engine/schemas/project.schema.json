{
  "title": "docs/_cgspec/project.json \u2014 version marker",
  "type": "object",
  "required": [
    "schema",
    "cgspec_version",
    "profile",
    "topology",
    "path_classes",
    "tools"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "cgspec_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "profile": {
      "enum": [
        "website",
        "web-workspace",
        "mobile",
        "cli",
        "headless",
        "small"
      ]
    },
    "topology": {
      "enum": [
        "single",
        "monorepo",
        "large-monorepo",
        "polyrepo-governance",
        "polyrepo-member"
      ]
    },
    "repo_prefix": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "governance_repo": {
      "type": "string"
    },
    "design_tokens": {
      "type": "string",
      "minLength": 1
    },
    "path_classes": {
      "type": "object",
      "required": [
        "schema",
        "api",
        "auth",
        "deps",
        "code",
        "tests",
        "docs"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "$ref": "#/definitions/globs"
        },
        "api": {
          "$ref": "#/definitions/globs"
        },
        "auth": {
          "$ref": "#/definitions/globs"
        },
        "deps": {
          "$ref": "#/definitions/globs"
        },
        "code": {
          "$ref": "#/definitions/globs"
        },
        "tests": {
          "$ref": "#/definitions/globs"
        },
        "docs": {
          "$ref": "#/definitions/globs"
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "enum": [
          "claude",
          "antigravity",
          "codex",
          "cursor",
          "git",
          "ci"
        ]
      }
    },
    "design_system": {
      "type": "object",
      "required": [
        "name",
        "package",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "tokens": {
          "type": "string"
        }
      }
    },
    "plugin_source": {
      "type": "string",
      "minLength": 1
    },
    "test_command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "test_command_approval": {
      "type": "string"
    },
    "test_runners_approval": {
      "type": "string",
      "minLength": 1
    },
    "test_environments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "cwd", "setup", "readiness", "inputs", "timeout_seconds"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "cwd": {"$ref": "#/definitions/relativePath"},
          "setup": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "readiness": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "inputs": {"type": "array", "items": {"$ref": "#/definitions/relativePath"}},
          "network": {"enum": ["online", "offline-cache"]},
          "build": {"type": "array", "items": {"$ref": "#/definitions/argv"}},
          "services": {"type": "array", "items": {"$ref": "#/definitions/argv"}},
          "cleanup": {"$ref": "#/definitions/argv"},
          "variables": {"type": "object", "additionalProperties": {"type": "string"}},
          "secrets": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900}
        }
      }
    },
    "test_runners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "adapter", "command", "cwd", "selection", "applies_to", "environment", "timeout_seconds", "isolation", "report", "artifacts"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "adapter": {"enum": ["cgspec-json", "vitest-json", "playwright-json", "legacy-exit"]},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"$ref": "#/definitions/relativePath"},
          "selection": {"enum": ["test_file"]},
          "applies_to": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/relativePath"}},
          "environment": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 900},
          "isolation": {"enum": ["per-run-worktree"]},
          "report": {"enum": ["json", "stdout-json"]},
          "artifacts": {"type": "array", "items": {"$ref": "#/definitions/relativePath"}}
        }
      }
    },
    "approver_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "visual_drift_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    }
  },
  "definitions": {
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "relativePath": {
      "type": "string",
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$)).+$"
    },
    "globs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
