{
  "title": "docs/_cgspec/07-state/checkpoint.json \u2014 enough to resume after any interruption",
  "type": "object",
  "required": [
    "schema",
    "updated",
    "goal",
    "stages",
    "next_action",
    "in_flight"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "updated": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "brainstorming",
          "design",
          "architecture",
          "milestones",
          "coding",
          "testing",
          "cicd",
          "follow-up"
        ]
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "revision": {
      "type": "string"
    },
    "evidence_done": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    },
    "in_flight": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "wakeup": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "scheduler",
                "timer",
                "paste",
                "none"
              ]
            },
            "id": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "paste_line": {
              "type": "string"
            }
          }
        }
      ]
    },
    "awaiting_user": {
      "description": "A question the agent stopped to ask. Keeps the batch in flight; excuses exactly one stop, then is marked used. count is the number of questions put to the user during the current in-flight batch; only hosts with a stop check increase it.",
      "type": "object",
      "required": [
        "at",
        "question",
        "used"
      ],
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "pattern": "\\S"
        },
        "used": {
          "type": "boolean"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "unresolved_stop": {
      "type": "object",
      "required": [
        "at",
        "problems"
      ],
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string"
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "observed_at",
        "head",
        "branch",
        "entries",
        "complete",
        "gaps",
        "excluded",
        "identity"
      ],
      "additionalProperties": false,
      "properties": {
        "observed_at": {
          "type": "string"
        },
        "head": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "branch": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "status",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "complete": {
          "type": "boolean"
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      }
    }
  }
}
