{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CGSpecBrownfieldManifest",
  "description": "Formal schema for reverse-engineered brownfield codebase manifests generated by cgspec ingest.",
  "type": "object",
  "required": [
    "schema_version",
    "project_root",
    "ingested_at",
    "frameworks",
    "subsystem",
    "models",
    "endpoints",
    "database_tables",
    "distilled_nouns"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "project_root": {
      "type": "string"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "subsystem": {
      "type": ["string", "null"],
      "description": "Target subsystem path for bounded context ingestion (Strangler Fig pattern)."
    },
    "frameworks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "source_file", "framework"],
        "properties": {
          "name": { "type": "string" },
          "source_file": { "type": "string" },
          "framework": { "type": "string" },
          "fields": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "path", "source_file"],
        "properties": {
          "method": { "type": "string" },
          "path": { "type": "string" },
          "source_file": { "type": "string" },
          "handler": { "type": "string" }
        }
      }
    },
    "database_tables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["table_name", "source_file"],
        "properties": {
          "table_name": { "type": "string" },
          "source_file": { "type": "string" },
          "columns": {
            "type": "array",
            "items": { "type": "string" }
          },
          "foreign_keys": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "distilled_nouns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["noun", "description"],
        "properties": {
          "noun": { "type": "string" },
          "description": { "type": "string" },
          "inferred_attributes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
