#!/bin/sh
# CGSpec pre-commit hook.
#
# This repository is the plugin source, not an installed consumer project, so the
# consumer commit gate cannot run here (it needs docs/_cgspec/project.json). The
# source gate below enforces the spec-1 content rules that need no project state.
#
# A hook that cannot find its checker refuses the commit. It must never exit 0
# silently: a guard that looks active and does nothing is worse than no guard.

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "cgspec: not inside a git work tree; refusing the commit." >&2
    exit 1
}

if [ -f "$root/.githooks/source_precommit.py" ]; then
    exec python3 "$root/.githooks/source_precommit.py"
fi

if [ -f "$root/docs/_cgspec/01-engine/cgspec_hook.py" ]; then
    exec python3 "$root/docs/_cgspec/01-engine/cgspec_hook.py" git-pre-commit
fi

echo "cgspec: no checker found at .githooks/source_precommit.py or" >&2
echo "cgspec: docs/_cgspec/01-engine/cgspec_hook.py; refusing the commit." >&2
echo "cgspec: restore the checker, or pass --no-verify with a stated reason." >&2
exit 1
